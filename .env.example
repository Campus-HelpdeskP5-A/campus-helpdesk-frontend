# Copy this file to .env and adjust values.

# Base URL of your backend REST API.
# Example when your backend runs locally on port 8000:
VITE_API_BASE_URL=http://localhost:8000/api

# true  -> the app uses the mock data in src/mock/* (no backend needed)
# false -> the app calls VITE_API_BASE_URL for everything
VITE_USE_MOCKS=true
